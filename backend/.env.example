# Server Configuration
PORT=5000

# Database Configuration (Docker PostgreSQL)
DATABASE_URL="postgresql://lmsuser:lmspassword@localhost:54322/lms_db?schema=public"

# Docker PostgreSQL Configuration
POSTGRES_USER=lmsuser
POSTGRES_PASSWORD=lmspassword
POSTGRES_DB=lms_db

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-please-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Environment
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
